// Coastline Prints data model.
// Money is always integer CAD cents. JSON-ish fields are stored as String so
// the schema works on SQLite and Postgres alike.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// An uploaded STL. Stats are computed by the server parser, never the client.
model Upload {
  id             String   @id @default(cuid())
  storageKey     String   @unique
  originalName   String
  safeName       String
  sizeBytes      Int
  sha256         String
  format         String // "binary" | "ascii" (STL) | "3mf"
  /// 3MF only, JSON ColorInfo: the project's filaments and which the model uses.
  colorInfo      String?
  /// JSON SupportProfile: overhangs needing support, for each way up.
  supportInfo    String?
  triangleCount  Int
  volumeMm3      Float
  surfaceAreaMm2 Float
  bboxX          Float
  bboxY          Float
  bboxZ          Float
  boundaryEdges  Int
  nonManifold    Int
  warnings       String   @default("[]") // JSON MeshWarning[]
  /// Set when the stored file is removed by the retention cleanup.
  fileDeletedAt  DateTime?
  createdAt      DateTime @default(now())

  orderItems OrderItem[]

  @@index([sha256])
  @@index([createdAt])
}

/// A payment attempt. Created PENDING before charging; becomes an Order only
/// once Square reports COMPLETED. idempotencyKey comes from the browser's
/// "Pay" attempt, so a retried request reuses the same Square payment.
model Checkout {
  id               String   @id @default(cuid())
  status           String   @default("PENDING") // PENDING | COMPLETED | FAILED
  idempotencyKey   String   @unique
  cart             String // JSON: server-priced cart snapshot
  totalCents       Int
  currency         String   @default("CAD")
  customerName     String
  customerEmail    String
  customerPhone    String
  notes            String?
  pickupDate       String? // "YYYY-MM-DD", shop time zone
  pickupTime       String? // "HH:MM" slot start
  /// PICKUP or SHIP (Canada Post bubble mailer or flat rate box).
  fulfillment      String   @default("PICKUP")
  /// Shipping charged: postage plus packing fee. 0 for pickup.
  shippingCents    Int      @default(0)
  /// JSON packages: the mailer or flat rate boxes, and how many pieces in each.
  shippingBoxes    String?
  shipName         String?
  shipLine1        String?
  shipLine2        String?
  shipCity         String?
  shipProvince     String?
  shipPostal       String?
  /// CARD (Square) or ETRANSFER (Interac, matched from the deposit email).
  paymentMethod    String   @default("CARD")
  /// The code the customer puts in the e-Transfer message, e.g. "PAY-7K4QX".
  etransferCode    String?  @unique
  /// Discount for paying by e-Transfer (no card fees).
  etransferDiscountCents Int @default(0)
  /// e-Transfer checkouts are cancelled if nothing arrives by then.
  expiresAt        DateTime?
  squarePaymentId  String?  @unique
  squareCustomerId String?
  /// JSON AppliedCode[]: coupons and gift cards used, with amounts.
  appliedCodes     String   @default("[]")
  discountCents    Int      @default(0)
  giftCardCents    Int      @default(0)
  failureReason    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order       Order?
  redemptions CodeRedemption[]
  etransferDeposit EtransferDeposit?
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  /// Unguessable token for the customer's confirmation link (shows pickup address).
  viewToken       String   @unique
  checkoutId      String   @unique
  checkout        Checkout @relation(fields: [checkoutId], references: [id])
  status          String   @default("PAID") // PAID | QUEUED | PRINTING | POST_PROCESSING | READY_FOR_PICKUP | PICKED_UP
  customerName    String
  customerEmail   String
  customerPhone   String
  notes           String?
  pickupDate      String? // "YYYY-MM-DD", shop time zone
  pickupTime      String? // "HH:MM" slot start
  /// PICKUP or SHIP (Canada Post bubble mailer or flat rate box).
  fulfillment      String   @default("PICKUP")
  /// Shipping charged: postage plus packing fee. 0 for pickup.
  shippingCents    Int      @default(0)
  /// JSON packages: the mailer or flat rate boxes, and how many pieces in each.
  shippingBoxes    String?
  shipName         String?
  shipLine1        String?
  shipLine2        String?
  shipCity         String?
  shipProvince     String?
  shipPostal       String?
  /// Canada Post tracking number, added when the order ships.
  trackingNumber   String?
  subtotalCents   Int
  baseFeeCents    Int
  minimumAdjCents Int      @default(0)
  discountCents   Int      @default(0)
  giftCardCents   Int      @default(0)
  /// JSON AppliedCode[]
  appliedCodes    String   @default("[]")
  totalCents      Int
  currency        String   @default("CAD")
  /// CARD or ETRANSFER.
  paymentMethod   String   @default("CARD")
  etransferDiscountCents Int @default(0)
  /// "nopay_<checkoutId>" when a gift card covered the whole order; "etr_<depositId>" for e-Transfers.
  squarePaymentId String   @unique
  squareCustomerId String?
  /// 1 = first order from this email, 2 = second, ...
  customerOrderCount Int    @default(1)
  receiptUrl      String?
  cardBrand       String?
  cardLast4       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items  OrderItem[]
  events OrderStatusEvent[]

  @@index([status])
  @@index([customerEmail])
  @@index([createdAt])
}

model OrderItem {
  id            String @id @default(cuid())
  orderId       String
  order         Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  uploadId      String
  upload        Upload @relation(fields: [uploadId], references: [id])
  fileName      String
  unitFactor    Float  @default(1) // 25.4 when "modelled in inches" was applied
  scaleX        Float
  scaleY        Float
  scaleZ        Float
  orientation   Int // index into ORIENTATIONS
  sizeX         Float // final printed size, mm, as oriented on the bed
  sizeY         Float
  sizeZ         Float
  material      String
  colorId       String
  colorName     String
  /// Multicolour 3MF: JSON ColorSlot[] (which stock colour each file colour prints in).
  colorSlots    String?
  quality       String
  infill        String
  quantity      Int
  printerId     String
  printerName   String
  gramsEach     Float
  hoursEach     Float
  unitCents     Int
  lineCents     Int

  @@index([printerId])
}

model OrderStatusEvent {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus       String?
  toStatus         String
  note             String?
  customerNotified Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([orderId])
}

/// Durable outbox for emails and Discord posts, retried with backoff.
model OutboxJob {
  id            String   @id @default(cuid())
  kind          String // "email" | "discord"
  template      String
  payload       String // JSON
  status        String   @default("PENDING") // PENDING | SENT | FAILED
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?
  dedupeKey     String?  @unique
  createdAt     DateTime @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
}

/// Admin-edited overrides of the config/*.ts defaults.
model Setting {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}

/// Coupon or gift card issued from the admin panel.
model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique // stored uppercase; gift cards: 16 digits
  /// Gift cards: "CP" + 5 digits, required alongside the number.
  pin           String?
  kind          String // PERCENT | AMOUNT | GIFT_CARD
  percentOff    Int?
  amountCents   Int? // AMOUNT: dollars off
  initialCents  Int? // GIFT_CARD: starting value
  balanceCents  Int? // GIFT_CARD: what's left
  minOrderCents Int       @default(0)
  maxUses       Int? // coupons: null = unlimited
  uses          Int       @default(0)
  expiresAt     DateTime?
  active        Boolean   @default(true)
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  redemptions CodeRedemption[]
  /// Set when the card was bought online on the gift card page.
  purchase    GiftPurchase?
  /// Saved to (and locked to) a customer account at /redeem. Only that account can spend it.
  ownerId       String?
  owner         Customer? @relation("Saved", fields: [ownerId], references: [id])
  savedAt       DateTime?
  /// First-order thank-you coupons: the order they were made for (one per order).
  rewardOrderId String?   @unique
  /// Invite codes: the account that shares it. Works on a friend's first order only.
  referrerId    String?   @unique
  referrer      Customer? @relation("Invites", fields: [referrerId], references: [id])

  @@index([ownerId])
}

/// A code held for a checkout. RESERVED while paying, USED once paid, RELEASED if the payment failed.
model CodeRedemption {
  id          String    @id @default(cuid())
  codeId      String
  code        PromoCode @relation(fields: [codeId], references: [id])
  checkoutId  String
  checkout    Checkout  @relation(fields: [checkoutId], references: [id])
  amountCents Int
  status      String    @default("RESERVED")
  createdAt   DateTime  @default(now())

  @@unique([codeId, checkoutId])
  @@index([checkoutId])
}

/// A gift card bought online. The card (PromoCode) is only created once
/// Square confirms the payment; the gift email is queued for deliverAt.
model GiftPurchase {
  id              String     @id @default(cuid())
  status          String     @default("PENDING") // PENDING | PAID | FAILED
  idempotencyKey  String     @unique
  amountCents     Int
  buyerName       String
  buyerEmail      String
  recipientName   String
  recipientEmail  String
  message         String?
  /// "YYYY-MM-DD" in the shop time zone, or null to send straight away.
  sendOn          String?
  /// When the gift email goes out (9 am Pacific on sendOn, or right after payment).
  deliverAt       DateTime
  squarePaymentId String?    @unique
  receiptUrl      String?
  cardBrand       String?
  cardLast4       String?
  failureReason   String?
  codeId          String?    @unique
  code            PromoCode? @relation(fields: [codeId], references: [id])
  paidAt          DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status, deliverAt])
}

/// A customer account. Sign-in is by a 6-digit code emailed to them; no passwords.
model Customer {
  id         String            @id @default(cuid())
  email      String            @unique
  /// Their customer record in Square (found or created once, never duplicated).
  squareCustomerId String?
  /// Saved details, used to fill in checkout. Empty until they set them or place an order.
  name       String?
  phone      String?
  /// JSON AddressInput: where they ship to, filled in at checkout when shipping.
  shipAddress String?
  /// "light" or "dark"; applied whenever they sign in.
  theme      String?
  createdAt  DateTime          @default(now())
  lastSeenAt DateTime?
  sessions   CustomerSession[]
  codes      PromoCode[] @relation("Saved")
  /// Their invite code, made the first time they open the account page.
  invite     PromoCode? @relation("Invites")
}

/// A signed-in browser. The cookie holds a random token; only its hash is stored.
model CustomerSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([customerId])
}

/// A one-time sign-in code (stored hashed), valid for a few minutes and a few tries.
model LoginCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

/// Rewards points ledger, by email (so points are earned even before someone
/// makes an account). Earned when an order is picked up; spent on prizes.
model PointsEntry {
  id        String   @id @default(cuid())
  email     String
  /// Positive when earned, negative when spent on a prize.
  points    Int
  kind      String // EARN | REDEEM | INVITE
  /// EARN: the order that earned them (once per order).
  orderId   String?  @unique
  /// INVITE: the friend's first order, placed with this person's invite code.
  inviteOrderId String? @unique
  /// REDEEM: which prize, and the coupon or gift card it made.
  prizeId   String?
  codeId    String?
  createdAt DateTime @default(now())

  @@index([email])
}

/// An Interac e-Transfer deposit email read from the shop's inbox.
model EtransferDeposit {
  id          String   @id @default(cuid())
  /// The email's Message-ID, so each deposit is handled once.
  messageId   String   @unique
  receivedAt  DateTime
  amountCents Int
  senderName  String?
  /// What the customer wrote in the e-Transfer message.
  memo        String?
  reference   String?
  /// True when the email's DKIM signature is Interac's (not forged).
  verified    Boolean  @default(false)
  /// MATCHED (paid an order) | REVIEW (needs the owner) | IGNORED
  status      String
  note        String?
  checkoutId  String?  @unique
  checkout    Checkout? @relation(fields: [checkoutId], references: [id])
  createdAt   DateTime @default(now())

  @@index([status])
}

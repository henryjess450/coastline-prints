// Coastline Prints data model.
// Money is always integer CAD cents. JSON-ish fields are stored as String so
// the schema works on SQLite and Postgres alike.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// An uploaded STL. Stats are computed by the server parser, never the client.
model Upload {
  id             String    @id @default(cuid())
  storageKey     String    @unique
  originalName   String
  safeName       String
  sizeBytes      Int
  sha256         String
  format         String // "binary" | "ascii" (STL) | "3mf"
  /// 3MF only, JSON ColorInfo: the project's filaments and which the model uses.
  colorInfo      String?
  /// JSON SupportProfile: overhangs needing support, for each way up.
  supportInfo    String?
  triangleCount  Int
  volumeMm3      Float
  surfaceAreaMm2 Float
  bboxX          Float
  bboxY          Float
  bboxZ          Float
  boundaryEdges  Int
  nonManifold    Int
  warnings       String    @default("[]") // JSON MeshWarning[]
  /// Set when the stored file is removed by the retention cleanup.
  fileDeletedAt  DateTime?
  createdAt      DateTime  @default(now())

  orderItems OrderItem[]

  @@index([sha256])
  @@index([createdAt])
}

/// A payment attempt. Created PENDING before charging; becomes an Order only
/// once Square reports COMPLETED. idempotencyKey comes from the browser's
/// "Pay" attempt, so a retried request reuses the same Square payment.
model Checkout {
  id                     String    @id @default(cuid())
  status                 String    @default("PENDING") // PENDING | COMPLETED | FAILED
  idempotencyKey         String    @unique
  /// Where they came from (src/lib/attribution.ts): the latest outside visit, the first one, and the details as JSON.
  source                 String?
  firstSource            String?
  sourceDetail           String?
  cart                   String // JSON: server-priced cart snapshot
  totalCents             Int
  currency               String    @default("CAD")
  customerName           String
  customerEmail          String
  customerPhone          String
  notes                  String?
  /// LightLab: a gift note to print and tuck in with the order.
  giftNote               String?
  pickupDate             String? // "YYYY-MM-DD", shop time zone
  pickupTime             String? // "HH:MM" slot start
  /// Picking up at a LightLab market day (Market.id) instead of the home pickup.
  pickupMarketId         String?
  /// PICKUP or SHIP (Canada Post bubble mailer or flat rate box).
  fulfillment            String    @default("PICKUP")
  /// Shipping charged: postage plus packing fee. 0 for pickup.
  shippingCents          Int       @default(0)
  /// JSON packages: the mailer or flat rate boxes, and how many pieces in each.
  shippingBoxes          String?
  shipName               String?
  shipLine1              String?
  shipLine2              String?
  shipCity               String?
  shipProvince           String?
  shipPostal             String?
  /// CARD (Square) or ETRANSFER (Interac, matched from the deposit email).
  paymentMethod          String    @default("CARD")
  /// The code the customer puts in the e-Transfer message, e.g. "PAY-7K4QX".
  etransferCode          String?   @unique
  /// Discount for paying by e-Transfer (no card fees).
  etransferDiscountCents Int       @default(0)
  /// e-Transfer checkouts are cancelled if nothing arrives by then.
  expiresAt              DateTime?
  squarePaymentId        String?   @unique
  squareCustomerId       String?
  /// JSON AppliedCode[]: coupons and gift cards used, with amounts.
  appliedCodes           String    @default("[]")
  discountCents          Int       @default(0)
  giftCardCents          Int       @default(0)
  failureReason          String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  order            Order?
  redemptions      CodeRedemption[]
  etransferDeposit EtransferDeposit?
}

model Order {
  id                     String    @id @default(cuid())
  orderNumber            String    @unique
  /// Unguessable token for the customer's confirmation link (shows pickup address).
  viewToken              String    @unique
  checkoutId             String    @unique
  checkout               Checkout  @relation(fields: [checkoutId], references: [id])
  status                 String    @default("PAID") // PAID | QUEUED | PRINTING | POST_PROCESSING | READY_FOR_PICKUP | PICKED_UP
  /// Tucked away by the owner: hidden from the admin's boards and lists (the customer still sees it).
  archivedAt             DateTime?
  customerName           String
  customerEmail          String
  customerPhone          String
  notes                  String?
  /// LightLab: a gift note to print and tuck in with the order.
  giftNote               String?
  pickupDate             String? // "YYYY-MM-DD", shop time zone
  pickupTime             String? // "HH:MM" slot start
  /// Picking up at a LightLab market day (Market.id) instead of the home pickup.
  pickupMarketId         String?
  /// PICKUP or SHIP (Canada Post bubble mailer or flat rate box).
  fulfillment            String    @default("PICKUP")
  /// Shipping charged: postage plus packing fee. 0 for pickup.
  shippingCents          Int       @default(0)
  /// JSON packages: the mailer or flat rate boxes, and how many pieces in each.
  shippingBoxes          String?
  shipName               String?
  shipLine1              String?
  shipLine2              String?
  shipCity               String?
  shipProvince           String?
  shipPostal             String?
  /// Canada Post tracking number, added when the order ships.
  trackingNumber         String?
  subtotalCents          Int
  baseFeeCents           Int
  minimumAdjCents        Int       @default(0)
  discountCents          Int       @default(0)
  giftCardCents          Int       @default(0)
  /// JSON AppliedCode[]
  appliedCodes           String    @default("[]")
  totalCents             Int
  currency               String    @default("CAD")
  /// CARD or ETRANSFER.
  paymentMethod          String    @default("CARD")
  etransferDiscountCents Int       @default(0)
  /// "nopay_<checkoutId>" when a gift card covered the whole order; "etr_<depositId>" for e-Transfers.
  squarePaymentId        String    @unique
  squareCustomerId       String?
  /// 1 = first order from this email, 2 = second, ...
  customerOrderCount     Int       @default(1)
  /// Where they came from (src/lib/attribution.ts): the latest outside visit, the first one, and the details as JSON.
  source                 String?
  firstSource            String?
  sourceDetail           String?
  receiptUrl             String?
  cardBrand              String?
  cardLast4              String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  items  OrderItem[]
  events OrderStatusEvent[]

  @@index([status])
  @@index([customerEmail])
  @@index([createdAt])
  @@index([source])
  @@index([pickupMarketId])
}

model OrderItem {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// The customer's uploaded file. Null for shop products (LightLab).
  uploadId    String?
  upload      Upload?      @relation(fields: [uploadId], references: [id])
  /// Shop product bought as-is (LightLab | Victoria). Null for custom prints.
  productId   String?
  product     ShopProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// The product option chosen (e.g. a shade colour), if it has options.
  variantId   String?
  fileName    String
  unitFactor  Float        @default(1) // 25.4 when "modelled in inches" was applied
  scaleX      Float
  scaleY      Float
  scaleZ      Float
  orientation Int // index into ORIENTATIONS
  sizeX       Float // final printed size, mm, as oriented on the bed
  sizeY       Float
  sizeZ       Float
  material    String
  colorId     String
  colorName   String
  /// Multicolour 3MF: JSON ColorSlot[] (which stock colour each file colour prints in).
  colorSlots  String?
  /// Limited runs: the numbers this line got (No. editionFrom to editionTo of the run).
  editionFrom Int?
  editionTo   Int?
  quality     String
  infill      String
  quantity    Int
  printerId   String
  printerName String
  gramsEach   Float
  hoursEach   Float
  unitCents   Int
  lineCents   Int

  @@index([printerId])
  @@index([productId])
}

model OrderStatusEvent {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus       String?
  toStatus         String
  note             String?
  customerNotified Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([orderId])
}

/// Durable outbox for emails and Discord posts, retried with backoff.
model OutboxJob {
  id            String    @id @default(cuid())
  kind          String // "email" | "discord"
  template      String
  payload       String // JSON
  status        String    @default("PENDING") // PENDING | SENT | FAILED
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  dedupeKey     String?   @unique
  createdAt     DateTime  @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
}

/// Admin-edited overrides of the config/*.ts defaults.
model Setting {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}

/// Coupon or gift card issued from the admin panel.
model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique // stored uppercase; gift cards: 16 digits
  /// Gift cards: "CP" + 5 digits, required alongside the number.
  pin           String?
  kind          String // PERCENT | AMOUNT | GIFT_CARD
  percentOff    Int?
  amountCents   Int? // AMOUNT: dollars off
  initialCents  Int? // GIFT_CARD: starting value
  balanceCents  Int? // GIFT_CARD: what's left
  minOrderCents Int       @default(0)
  maxUses       Int? // coupons: null = unlimited
  uses          Int       @default(0)
  expiresAt     DateTime?
  active        Boolean   @default(true)
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  redemptions     CodeRedemption[]
  /// Set when the card was bought online on the gift card page.
  purchase        GiftPurchase?
  /// Saved to (and locked to) a customer account at /redeem. Only that account can spend it.
  ownerId         String?
  owner           Customer?        @relation("Saved", fields: [ownerId], references: [id])
  savedAt         DateTime?
  /// First-order thank-you coupons: the order they were made for (one per order).
  rewardOrderId   String?          @unique
  /// Invite codes: the account that shares it. Works on a friend's first order only.
  referrerId      String?          @unique
  referrer        Customer?        @relation("Invites", fields: [referrerId], references: [id])
  /// Only works at the LightLab market stand register, never online.
  marketOnly      Boolean          @default(false)
  /// "Come back" coupons printed on a stand receipt: the order it was printed for (one each)...
  comebackOrderId String?          @unique
  /// ...and the market it was handed out at, to see which markets bring people back.
  issuedMarket    String?
  /// Printed thank-you cards (LightLab admin > Thank-you cards): the batch it was printed in.
  cardBatch       String?

  @@index([ownerId])
  @@index([cardBatch])
}

/// A code held for a checkout. RESERVED while paying, USED once paid, RELEASED if the payment failed.
model CodeRedemption {
  id          String    @id @default(cuid())
  codeId      String
  code        PromoCode @relation(fields: [codeId], references: [id])
  checkoutId  String
  checkout    Checkout  @relation(fields: [checkoutId], references: [id])
  amountCents Int
  status      String    @default("RESERVED")
  createdAt   DateTime  @default(now())

  @@unique([codeId, checkoutId])
  @@index([checkoutId])
}

/// A gift card bought online. The card (PromoCode) is only created once
/// Square confirms the payment; the gift email is queued for deliverAt.
model GiftPurchase {
  id              String     @id @default(cuid())
  status          String     @default("PENDING") // PENDING | PAID | FAILED
  idempotencyKey  String     @unique
  amountCents     Int
  /// Card processing fee the buyer chose to cover (charged on top of amountCents).
  feeCents       Int      @default(0)
  /// Extra value from a promotion (like the holiday bonus), added to the card on top of what was paid.
  bonusCents      Int        @default(0)
  /// coastline | holiday (src/lib/giftcards/designs.ts). Every design works everywhere.
  design          String     @default("coastline")
  /// Where the buyer came from (src/lib/attribution.ts).
  source          String?
  sourceDetail    String?
  /// Unguessable link for the recipient's "open your gift" page.
  revealToken     String?    @unique
  buyerName       String
  buyerEmail      String
  recipientName   String
  recipientEmail  String
  message         String?
  /// "YYYY-MM-DD" in the shop time zone, or null to send straight away.
  sendOn          String?
  /// When the gift email goes out (9 am Pacific on sendOn, or right after payment).
  deliverAt       DateTime
  squarePaymentId String?    @unique
  receiptUrl      String?
  cardBrand       String?
  cardLast4       String?
  failureReason   String?
  codeId          String?    @unique
  code            PromoCode? @relation(fields: [codeId], references: [id])
  paidAt          DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status, deliverAt])
}

/// A customer account. Sign-in is by a 6-digit code emailed to them; no passwords.
model Customer {
  id               String            @id @default(cuid())
  email            String            @unique
  /// Their customer record in Square (found or created once, never duplicated).
  squareCustomerId String?
  /// Saved details, used to fill in checkout. Empty until they set them or place an order.
  name             String?
  phone            String?
  /// JSON AddressInput: where they ship to, filled in at checkout when shipping.
  shipAddress      String?
  /// "light" or "dark"; applied whenever they sign in.
  theme            String?
  /// Said no to news and promotions (order emails still come).
  emailOptOut      Boolean           @default(false)
  /// Signed up for LightLab updates at the stand: when, and where ("LightLab updates · Holiday Craft Fair"). Their consent record.
  joinedAt         DateTime?
  joinedFrom       String?
  /// When the owner set up this account for them from the admin panel.
  invitedAt        DateTime?
  createdAt        DateTime          @default(now())
  lastSeenAt       DateTime?
  sessions         CustomerSession[]
  codes            PromoCode[]       @relation("Saved")
  /// Their invite code, made the first time they open the account page.
  invite           PromoCode?        @relation("Invites")
}

/// A signed-in browser. The cookie holds a random token; only its hash is stored.
model CustomerSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([customerId])
}

/// A one-time sign-in code (stored hashed), valid for a few minutes and a few tries.
model LoginCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

/// Rewards points ledger, by email (so points are earned even before someone
/// makes an account). Earned when an order is picked up; spent on prizes.
model PointsEntry {
  id            String   @id @default(cuid())
  email         String
  /// Positive when earned, negative when spent on a prize.
  points        Int
  kind          String // EARN | REDEEM | INVITE
  /// EARN: the order that earned them (once per order).
  orderId       String?  @unique
  /// INVITE: the friend's first order, placed with this person's invite code.
  inviteOrderId String?  @unique
  /// REDEEM: which prize, and the coupon or gift card it made.
  prizeId       String?
  codeId        String?
  createdAt     DateTime @default(now())

  @@index([email])
}

/// An Interac e-Transfer deposit email read from the shop's inbox.
model EtransferDeposit {
  id          String    @id @default(cuid())
  /// The email's Message-ID, so each deposit is handled once.
  messageId   String    @unique
  receivedAt  DateTime
  amountCents Int
  senderName  String?
  /// What the customer wrote in the e-Transfer message.
  memo        String?
  reference   String?
  /// True when the email's DKIM signature is Interac's (not forged).
  verified    Boolean   @default(false)
  /// MATCHED (paid an order) | REVIEW (needs the owner) | IGNORED
  status      String
  note        String?
  checkoutId  String?   @unique
  checkout    Checkout? @relation(fields: [checkoutId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([status])
}

/// A bar across the top of every page, between its start and end (if set).
model Announcement {
  id        String    @id @default(cuid())
  message   String
  linkUrl   String?
  linkLabel String?
  startsAt  DateTime?
  endsAt    DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

/// An email sent to every customer who hasn't opted out: news, or a coupon campaign.
model Broadcast {
  id        String   @id @default(cuid())
  subject   String
  heading   String
  body      String
  linkUrl   String?
  linkLabel String?
  /// Coupon campaigns: the shared code it shows.
  code      String?
  sentCount Int      @default(0)
  createdAt DateTime @default(now())
}

/// A site-wide sale: a percentage off the prints on every order between its dates.
model Sale {
  id         String   @id @default(cuid())
  name       String
  percentOff Int
  startsAt   DateTime
  endsAt     DateTime
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([startsAt, endsAt])
}

/// A ready-made product in a partner shop (LightLab | Victoria at /lightlab), edited at /lightlab/admin.
model ShopProduct {
  id             String   @id @default(cuid())
  /// Which shop it belongs to: "lightlab" or "coastline" (config/shops.ts).
  shop           String   @default("lightlab")
  slug           String   @unique
  name           String
  /// One line under the name on the shop grid.
  tagline        String   @default("")
  description    String   @default("")
  category       String   @default("")
  /// Asks the shopper for text, like "Name on the keychain". Null = nothing to personalise.
  personalize    String?
  priceCents     Int
  /// Shown struck through next to the price when set (a markdown).
  compareAtCents Int?
  /// How many are on hand. Null = made to order (never runs out).
  stock          Int?
  /// JSON ShopVariant[]: options like shade colour, each with its own price and stock if set.
  variants       String   @default("[]")
  /// JSON string[] of storage keys under shop/, first one is the cover.
  images         String   @default("[]")
  /// Price tag: the line drawing on the left (storage key under shop/), the
  /// name's colours (JSON hex list: one = solid, more = a left-to-right
  /// gradient) and the price colour (null = follows the name).
  tagImage       String?
  tagColors      String   @default("[]")
  tagPriceColor  String?
  /// Packed size and weight, for shipping quotes.
  sizeXMm        Float    @default(150)
  sizeYMm        Float    @default(150)
  sizeZMm        Float    @default(150)
  grams          Float    @default(300)
  active         Boolean  @default(true)
  featured       Boolean  @default(false)
  /// JSON SeasonId[] (config/seasons.ts): the holidays it's for. When the
  /// site theme is one of them it's promoted on the shop and gets a sparkle.
  seasons        String   @default("[]")
  /// Hidden from the shop grid while none of its seasons is the site theme.
  seasonOnly     Boolean  @default(false)
  /// JSON product ids picked by hand as "goes well with"; suggested first.
  pairings       String   @default("[]")
  /// An add-on (spare bulb, smart bulb, inline switch): offered as a one-tap extra in the cart, not on the shop grid.
  addon          Boolean  @default(false)
  /// Numbered limited run: how many will ever be sold ("No. 7 of 25"). Null = not limited.
  editionSize    Int?
  /// How many numbers of the run are taken so far (the next buyer gets editionSold + 1).
  editionSold    Int      @default(0)
  /// Drop date: shown with a countdown and can't be bought before this. Null = on sale now.
  dropAt         DateTime?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderItems      OrderItem[]
  restockRequests RestockRequest[]
  files           ShopProductFile[]

  @@index([shop, active, sortOrder])
}

/// The owner's own print files for a shop product (STL, 3MF...). Admin only, never shown on the shop.
model ShopProductFile {
  id         String      @id @default(cuid())
  productId  String
  product    ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileName   String
  /// Storage key under shop-files/.
  storageKey String      @unique
  sizeBytes  Int
  note       String      @default("")
  createdAt  DateTime    @default(now())

  @@index([productId])
}

/// A market LightLab will be at, shown under "Find us at" on /lightlab. Past dates hide themselves.
model Market {
  id        String   @id @default(cuid())
  name      String
  /// Where, as people would say it ("Moss Street Market").
  place     String
  /// Street address for the map link (optional).
  address   String   @default("")
  /// "YYYY-MM-DD", shop time zone.
  date      String
  /// "HH:MM", 24-hour.
  startTime String
  endTime   String
  note      String   @default("")
  /// The market's own page (optional).
  url       String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

/// "Tell me when it's back": an email to send when a sold-out product (or option) is restocked.
model RestockRequest {
  id         String      @id @default(cuid())
  productId  String
  product    ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The option they wanted, or "" for the product itself.
  variantId  String      @default("")
  email      String
  notifiedAt DateTime?
  createdAt  DateTime    @default(now())

  @@unique([productId, variantId, email])
  @@index([productId, notifiedAt])
}

/// Animations queued for the order lamp (ESP32 + LED ring, firmware/lamp), which polls /api/lamp.
model LampEvent {
  id        Int      @id @default(autoincrement())
  anim      String
  /// The sale in whole dollars, for Payment (one LED per dollar).
  value     Int?
  /// Why it played: "print", "coastline", "lightlab", "gift" or "dash".
  reason    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A customer-facing display for the in-person register (src/lib/pos). The
/// tablet keeps displayToken in a cookie and shows a pair code until the
/// cashier enters it; after that the cashier pushes what's on screen and the
/// customer can type an email back.
model PosRegister {
  id            String    @id @default(cuid())
  /// Shown big on an unpaired display; cleared once paired.
  pairCode      String?   @unique
  displayToken  String    @unique
  pairedAt      DateTime?
  /// JSON PosScreen: what the display shows right now.
  screen        String    @default("{\"stage\":\"idle\"}")
  /// Typed by the customer on the display, picked up by the cashier.
  customerEmail String?
  /// JSON PosReply: the customer's answer to the last popup (email, account sign-up, closed it).
  reply         String?
  /// Bumped on every change, so both sides poll cheaply.
  version       Int       @default(0)
  lastSeenAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// A ticket or receipt waiting for the print bridge (bridge/print-bridge.mjs),
/// which plugs into the printer away from home, e.g. at a market stand.
model PrintJob {
  id        String    @id @default(cuid())
  /// What it is, for the admin list: "Receipt R-1042", "Test print"...
  label     String
  /// Printer-ready bytes (Star raster or ESC/POS).
  bytes     Bytes
  /// QUEUED → SENT (bridge took it) → PRINTED, or FAILED / CANCELLED.
  status    String    @default("QUEUED")
  error     String?
  createdAt DateTime  @default(now())
  takenAt   DateTime?
  doneAt    DateTime?

  @@index([status, createdAt])
}

/// A self-checkout tablet at the LightLab stand (/kiosk). It shows a code until
/// the owner pairs it in LightLab admin > Kiosk; then its cookie (token) lets it
/// start sales that the shopper pays for on their own phone.
model Kiosk {
  id         String      @id @default(cuid())
  name       String      @default("Kiosk")
  /// "shop": take lamps home now. "order": made to order, ready by a day they pick. Both are paid on the shopper's phone.
  mode       String      @default("shop")
  /// Shown on the tablet until it's paired.
  pairCode   String?     @unique
  token      String      @unique
  pairedAt   DateTime?
  lastSeenAt DateTime    @default(now())
  createdAt  DateTime    @default(now())
  sales      KioskSale[]
}

/// One self-checkout at a kiosk: the cart as the server priced it, and the
/// Square payment link the shopper scans. Rung up once Square says it's paid.
model KioskSale {
  /// Also the register sale's attemptId, so it can only be rung up once.
  id           String   @id
  kioskId      String
  kiosk        Kiosk    @relation(fields: [kioskId], references: [id], onDelete: Cascade)
  /// JSON PosCartInput.
  cart         String
  totalCents   Int
  linkId       String
  linkUrl      String
  squareOrder  String
  customerName String   @default("")
  email        String   @default("")
  phone        String   @default("")
  notes        String   @default("")
  /// Order-mode kiosks: the day it's to be ready ("YYYY-MM-DD"). Null = taken home now.
  needBy       String?
  /// PENDING → DONE (order made) or CANCELLED; PROBLEM = paid but the sale couldn't be saved (see `problem`).
  status       String   @default("PENDING")
  orderNumber  String?
  problem      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([kioskId, createdAt])
}

/// "In the wild": a customer's photo of their LightLab lamp at home, added by the owner (usually from an Instagram tag).
model WildPhoto {
  id         String   @id @default(cuid())
  /// Storage key under shop/ (uploaded like product photos).
  storageKey String   @unique
  /// Who took it, shown as credit ("@name"). Empty = no credit.
  handle     String   @default("")
  caption    String   @default("")
  /// The lamp in the photo, so it also shows on that product's page.
  productId  String?
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([active, sortOrder])
  @@index([productId])
}

/// "Make me a lamp": a LightLab commission request, quoted by the owner and paid online.
model LampCommission {
  id            String    @id @default(cuid())
  /// Unguessable token for the customer's request page (quote, accept, pay).
  token         String    @unique
  /// NEW (waiting for a quote) | QUOTED | ACCEPTED (waiting for payment) | PAID | DECLINED (by the customer) | CLOSED (by the owner)
  status        String    @default("NEW")
  name          String
  email         String
  phone         String    @default("")
  /// What they want: the figure, the idea.
  idea          String
  /// Shade colour picked (a stock colour name), or "" for "help me choose".
  shade         String    @default("")
  shadeHex      String?
  /// "YYYY-MM-DD" they'd like it by, or "" for whenever.
  neededBy      String    @default("")
  /// JSON string[] of storage keys under commission/.
  photos        String    @default("[]")
  quoteCents    Int?
  /// The owner's note with the quote (what's included, how long it takes).
  quoteNote     String    @default("")
  quotedAt      DateTime?
  acceptedAt    DateTime?
  /// The PENDING checkout made on accept (e-Transfer code), and the card one with its Square pay link.
  checkoutId    String?   @unique
  cardCheckoutId String?  @unique
  payLinkId     String?
  payLinkUrl    String?
  payLinkOrder  String?
  orderId       String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
}

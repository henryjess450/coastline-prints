# ── Database ─────────────────────────────────────────────
# SQLite for local dev. For Postgres: change provider in prisma/schema.prisma
# and set e.g. postgresql://user:pass@host:5432/toylab
DATABASE_URL="file:./coastline.db"

# ── Site ─────────────────────────────────────────────────
APP_URL="https://comissions.henryjess.ca"
# Web server (scripts/start.mjs). HOST 127.0.0.1 = only reachable through Caddy.
PORT="3100"
HOST="127.0.0.1"
NEXT_PUBLIC_MAX_UPLOAD_MB="100"
PICKUP_ADDRESS="123 Example Street"   # your real pickup address (kept private)
OWNER_EMAIL="coastline.printz@gmail.com"

# ── Storage ──────────────────────────────────────────────
STORAGE_DRIVER="local"          # local (S3/R2 later)
STORAGE_DIR="./storage"

# ── Square (payments) ────────────────────────────────────
# Sandbox keys from https://developer.squareup.com/apps → your app → Credentials.
SQUARE_ENVIRONMENT="sandbox"        # sandbox | production
SQUARE_ACCESS_TOKEN=""
SQUARE_APPLICATION_ID=""
SQUARE_LOCATION_ID=""
# Webhooks → add subscription for payment.created + payment.updated
SQUARE_WEBHOOK_SIGNATURE_KEY=""
SQUARE_WEBHOOK_URL="https://comissions.henryjess.ca/api/webhooks/square"   # must match Square exactly

# ── Email (Gmail) ────────────────────────────────────────
# Use a Gmail App Password, NOT your normal password:
#   Google Account → Security → 2-Step Verification (turn on) → App passwords.
# Leave blank in development to write emails to storage/email-previews/ instead.
GMAIL_USER=""                       # e.g. coastlineprints@gmail.com
GMAIL_APP_PASSWORD=""               # 16 characters, spaces are fine
# EMAIL_FROM="Coastline Prints <coastlineprints@gmail.com>"   # optional override
# Any other SMTP server instead of Gmail: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS

# ── Notification worker ──────────────────────────────────
OUTBOX_WORKER="on"                  # "off" on serverless hosts; use the cron URL instead
CRON_SECRET=""                      # protects GET /api/cron/outbox
DISCORD_WEBHOOK_URL=""              # optional; leave blank to disable

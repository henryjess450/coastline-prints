# ── Database ─────────────────────────────────────────────
# SQLite for local dev. For Postgres: change provider in prisma/schema.prisma
# and set e.g. postgresql://user:pass@host:5432/toylab
DATABASE_URL="file:./coastline.db"

# ── Site ─────────────────────────────────────────────────
APP_URL="https://coastlineprints.ca"
# Web server (scripts/start.mjs). HOST 127.0.0.1 = only reachable through Caddy.
PORT="3100"
HOST="127.0.0.1"
NEXT_PUBLIC_MAX_UPLOAD_MB="100"
PICKUP_ADDRESS="123 Example Street"   # your real pickup address (kept private)
OWNER_EMAIL="coastline.printz@gmail.com"

# ── Storage ──────────────────────────────────────────────
STORAGE_DRIVER="local"          # local (S3/R2 later)
STORAGE_DIR="./storage"

# ── Square (payments) ────────────────────────────────────
# Sandbox keys from https://developer.squareup.com/apps → your app → Credentials.
SQUARE_ENVIRONMENT="sandbox"        # sandbox | production
SQUARE_ACCESS_TOKEN=""
SQUARE_APPLICATION_ID=""
SQUARE_LOCATION_ID=""
# Webhooks → add subscription for payment.created + payment.updated
SQUARE_WEBHOOK_SIGNATURE_KEY=""
SQUARE_WEBHOOK_URL="https://coastlineprints.ca/api/webhooks/square"   # must match Square exactly

# ── Email (Gmail) ────────────────────────────────────────
# Use a Gmail App Password, NOT your normal password:
#   Google Account → Security → 2-Step Verification (turn on) → App passwords.
# Leave blank in development to write emails to storage/email-previews/ instead.
GMAIL_USER=""                       # e.g. coastlineprints@gmail.com
GMAIL_APP_PASSWORD=""               # 16 characters, spaces are fine
# EMAIL_FROM="Coastline Prints <coastlineprints@gmail.com>"   # optional override
# Any other SMTP server instead of Gmail: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS

# ── Notification worker ──────────────────────────────────
OUTBOX_WORKER="on"                  # "off" on serverless hosts; use the cron URL instead
CRON_SECRET=""                      # protects GET /api/cron/outbox
DISCORD_WEBHOOK_URL=""              # optional; leave blank to disable

# ── Receipt printer (Star TSP654II on the shop network) ──
# Every paid order prints a receipt. Leave HOST empty to turn printing off.
RECEIPT_PRINTER_HOST="10.0.0.137"
RECEIPT_PRINTER_PORT="9100"
RECEIPT_PRINTER_MODE="star"        # star (default for TSP654II) or escpos

# ── Model library (optional; each adds a site to /library search) ──
# Thingiverse: thingiverse.com/apps/create → App Token
THINGIVERSE_TOKEN=""
# MyMiniFactory: myminifactory.com/settings/developer → API key
MYMINIFACTORY_API_KEY=""
# Cults3D: cults3d.com/en/api/keys → your username + API key
CULTS3D_USERNAME=""
CULTS3D_API_KEY=""

# ── Admin dashboard (Phase 5) ────────────────────────────
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
# Optional: AUTH_SECRET="any long random text" (extra secret for admin login cookies)

# Development only: test orders write emails to storage/email-previews/
# instead of sending. Set to "true" to really send while developing.
# EMAIL_SEND_IN_DEV="true"
# PRINT_IN_DEV="true"   # same for the receipt printer

# Optional: live Canada Post parcel rates for tracked bubble mailers (see SETUP.md section 5)
CANADA_POST_USERNAME=""
CANADA_POST_PASSWORD=""
CANADA_POST_FROM_POSTAL=""   # the postal code you mail from (kept private)

# Optional: Interac e-Transfer payments (see SETUP.md section 6)
ETRANSFER_EMAIL=""            # where customers send e-Transfers (your Autodeposit address)
ETRANSFER_IMAP_HOST="imap.titan.email"
ETRANSFER_IMAP_PORT="993"
ETRANSFER_IMAP_USER=""        # the mailbox the Interac emails land in
ETRANSFER_IMAP_PASSWORD=""    # that mailbox's password (kept private)

# A mailing address printed at the bottom of news and promotion emails
# (Canada's anti-spam law asks for one). Use a PO box or business address,
# never your home. Leave blank to leave it off.
MAILING_ADDRESS=
